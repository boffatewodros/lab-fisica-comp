int main(int argc, char *argv[]) {

    if (argc != 9) {
        printf("Uso: dt nsteps stride nwalks v0 gamma kT seed\n");
        return 1;
    }

    Cost sist;

    sist.dt = atof(argv[1]);

    int nsteps = atoi(argv[2]);
    int stride = atoi(argv[3]);
    int nwalks = atoi(argv[4]);

    double v0 = atof(argv[5]);

    sist.gamma = atof(argv[6]);
    sist.kT = atof(argv[7]);

    int seed = atoi(argv[8]);

    if (sist.dt <= 0 || nsteps < 0 || stride <= 0 ||
        nwalks <= 0 || sist.gamma <= 0 || sist.kT < 0) {
        return 1;
    }

    double t = 0;

    Punto *s = malloc(nwalks * sizeof(Punto));

    if (s == NULL) return 1;

    srand48(seed);

    // Condizioni iniziali
    for (int j = 0; j < nwalks; j++) {
        s[j].x = 0;
        s[j].v = v0;
    }

    // Stampa iniziale
    misura(s, nwalks, t);

    // Ciclo temporale
    for (int i = 1; i <= nsteps; i++) {

        for (int j = 0; j < nwalks; j++) {
            passo(&s[j], &sist);
        }

        t += sist.dt;

        if (i % stride == 0) {
            misura(s, nwalks, t);
        }
    }

    free(s);

    return 0;
}
